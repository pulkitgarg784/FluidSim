#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

#include "sph_params.glsl"
#include "whitewater_params.glsl"
#include "whitewater_shared.glsl"

layout(std430, binding = 3) readonly buffer Densities { vec2 densities[]; };
layout(std430, binding = 8) readonly buffer StartIndices { uint startIndices[]; };
layout(std430, binding = 10) buffer SortedVel { vec4 sortedVel[]; };
layout(std430, binding = 11) readonly buffer SortedPred { vec4 sortedPred[]; };
layout(std430, binding = 13) readonly buffer EndIndices { uint endIndices[]; };
layout(std430, binding = 15) buffer WhiteParticles {
  WhiteParticle whiteParticles[];
};
layout(std430, binding = 16) buffer WhitewaterAllocator {
  uint spawnCursor;
  uint activeCount;
  uint slotStates[];
};

float pressureFromDensity(float density) {
  return (density - P.targetDensity) * P.pressureMultiplier;
}

float nearPressureFromDensity(float density) {
  return density * P.gravity.w;
}

uint nextRandom(inout uint state) {
  state = state * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

float random01(inout uint state) {
  return float(nextRandom(state)) * (1.0 / 4294967295.0);
}

vec3 randomDirection(uint state) {
  uint word = nextRandom(state);
  float z = float(word & 0xffffu) * (2.0 / 65535.0) - 1.0;
  float angle = float((word >> 16) & 0xffffu) * (TWO_PI / 65535.0);
  float r = sqrt(max(0.0, 1.0 - z * z));
  return vec3(r * cos(angle), r * sin(angle), z);
}

float remap01(float value, float minValue, float maxValue) {
  return clamp((value - minValue) / max(maxValue - minValue, P.epsilon), 0.0,
               1.0);
}

vec3 perpendicular(vec3 direction) {
  vec3 axis =
      abs(direction.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
  return normalize(cross(direction, axis));
}

struct Neighbourhood {
  uint count;
  float convergence; // relative speed
  vec3 offsetSum;    // direction to the neighbours
  float weightSum;
};

// Secondary particles depend on air trapped between converging surfaces, fast
// downward motion into the water below, and crests thrown clear of the
// surface.
void spawnWhitewater(uint idx, vec3 pi, vec3 vi, vec3 velocity,
                     Neighbourhood neighbours) {
  float h = P.smoothingRadius;
  vec3 halfBounds = 0.5 * P.boundsSize.xyz;
  WallContact wall = wallContact(pi);
  uint wallAdjustedCount =
      neighbours.count + wallNeighbours(wall, neighbours.count);

  float trappedAir =
      remap01(neighbours.convergence, W.trappedAirMin, W.trappedAirMax);
  float kinetic = remap01(dot(vi, vi), W.kineticEnergyMin, W.kineticEnergyMax);
  float impactKinetic = remap01(dot(vi, vi), 3.0, 15.0);

  float floorClearance = pi.y + halfBounds.y - 0.5 * h;
  float downwardImpact = remap01(-vi.y, 1.0, 3.5) *
                         remap01(neighbours.convergence, 5.0, 15.0) *
                         clamp(floorClearance / h, 0.0, 1.0);

  float waveCrest = 0.0;
  float speed = length(vi);
  if (neighbours.weightSum > P.epsilon && speed > P.epsilon &&
      wallAdjustedCount < W.bubbleMinNeighbours) {
    vec3 outward = maskWallDirections(-normalize(neighbours.offsetSum), wall);
    if (dot(outward, outward) > P.epsilon * P.epsilon) {
      outward = normalize(outward);
      float surfaceExposure =
          1.0 - clamp((float(wallAdjustedCount) - float(W.sprayMaxNeighbours)) /
                          neighbourBand(),
                      0.0, 1.0);
      float surfaceAsymmetry =
          clamp(length(neighbours.offsetSum) / (h * neighbours.weightSum),
                0.0, 1.0);
      waveCrest = surfaceExposure * surfaceAsymmetry *
                  remap01(dot(vi / speed, outward), 0.6, 1.0) *
                  remap01(max(dot(vi, outward), 0.0), 0.5, 2.5);
    }
  }

  float potential = trappedAir * kinetic +
                    0.50 * downwardImpact * impactKinetic +
                    0.35 * waveCrest * impactKinetic;
  potential *= wall.clearance;

  uint rng = idx * 9781u + floatBitsToUint(pi.x) * 6271u +
             floatBitsToUint(pi.y) * 13007u + floatBitsToUint(pi.z) * 421u;
  float expected = W.generationRate * potential * P.deltaT;
  uint spawnCount = uint(floor(expected));
  if (random01(rng) < fract(expected))
    ++spawnCount;
  spawnCount = min(spawnCount, 4u);
  if (spawnCount == 0u)
    return;

  uint base = atomicAdd(spawnCursor, spawnCount);
  vec3 forward =
      length(velocity) > P.epsilon ? normalize(velocity) : vec3(0.0, 1.0, 0.0);
  vec3 axisA = perpendicular(forward);
  vec3 axisB = normalize(cross(forward, axisA));
  float type = classify(wallAdjustedCount, neighbours.count);

  for (uint s = 0u; s < spawnCount; ++s) {
    float angle = random01(rng) * TWO_PI;
    float radius = sqrt(random01(rng)) * h;
    vec3 radial = radius * (cos(angle) * axisA + sin(angle) * axisB);
    vec3 position = pi + radial + velocity * (P.deltaT * random01(rng));
    float life = mix(W.lifetimeMin, W.lifetimeMax, random01(rng));

    uint slot = (base + s) % W.capacity;
    if (atomicCompSwap(slotStates[slot], 0u, 1u) != 0u)
      continue;
    atomicAdd(activeCount, 1u);
    whiteParticles[slot].positionLife = vec4(position, life);
    whiteParticles[slot].velocityScale =
        vec4(velocity + radial, 0.5 * (1.0 + W.bubbleScale) + 2.0 * type);
  }
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= P.numParticles) return;

  vec3 pi = sortedPred[idx].xyz;
  vec3 vi = sortedVel[idx].xyz;
  vec2 densityI = max(densities[idx], vec2(P.epsilon));
  float pressureI = pressureFromDensity(densityI.x);
  float nearPressureI = nearPressureFromDensity(densityI.y);
  float h = P.smoothingRadius;
  float h2 = h * h;
  float nearGradientScale = 6.0 * P.densityKernelScale / h;

  vec3 force = vec3(0.0);
  Neighbourhood neighbours;
  neighbours.count = 0u;
  neighbours.convergence = 0.0;
  neighbours.offsetSum = vec3(0.0);
  neighbours.weightSum = 0.0;

  bool canSpawn =
      W.enabled != 0u && W.capacity != 0u && W.activeCount < W.capacity;

  ivec3 center = gridCell(pi);
  int centerKey = int(cellKey(center));
  ivec3 lo = neighbourMin(center);
  ivec3 hi = neighbourMax(center);

  for (int dz = lo.z; dz <= hi.z; ++dz)
  for (int dy = lo.y; dy <= hi.y; ++dy)
  for (int dx = lo.x; dx <= hi.x; ++dx) {
    uint key = neighbourKey(centerKey, ivec3(dx, dy, dz));
    uint start = startIndices[key];
    if (start == EMPTY_CELL) continue;
    uint end = endIndices[key];
    for (uint e = start; e < end; ++e) {
      if (e == idx) continue;
      vec3 offset = sortedPred[e].xyz - pi;
      float dst2 = dot(offset, offset);
      if (dst2 >= h2) continue;
      ++neighbours.count;
      float dst = sqrt(dst2);
      // Coincident particles have no gradient to follow, so pick a direction.
      vec3 dir = (dst < P.epsilon) ? randomDirection(idx * P.numParticles + e)
                                   : offset / dst;

      if (canSpawn) {
        vec3 relativeVelocity = vi - sortedVel[e].xyz;
        float relativeSpeed = length(relativeVelocity);
        float headOn =
            1.0 - dot(relativeVelocity / max(relativeSpeed, P.epsilon), -dir);
        float influence = 1.0 - dst / h;
        neighbours.convergence += relativeSpeed * headOn * influence;
        neighbours.offsetSum += offset * influence;
        neighbours.weightSum += influence;
      }

      vec2 densityJ = max(densities[e], vec2(P.epsilon));
      float sharedPressure =
          0.5 * (pressureFromDensity(densityJ.x) + pressureI);
      float sharedNearPressure =
          0.5 * (nearPressureFromDensity(densityJ.y) + nearPressureI);
      float v = h - dst;
      force += sharedPressure * dir * (-v * P.pressureGradientKernelScale) *
               P.particleMass / densityJ.x;
      force += sharedNearPressure * dir * (-v * v * nearGradientScale) *
               P.particleMass / densityJ.y;
    }
  }

  vec3 velocity = vi + (force / densityI.x) * P.deltaT;
  // airborn drag
  if (neighbours.count < 8u)
    velocity -= velocity * (0.75 * P.deltaT);
  sortedVel[idx] = vec4(velocity, 0.0);

  if (canSpawn)
    spawnWhitewater(idx, pi, vi, velocity, neighbours);
}
