#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions      { vec4 positions[];      };
layout(std430, binding = 1) buffer Velocities     { vec4 velocities[];     };
layout(std430, binding = 2) buffer Predicted      { vec4 predicted[];      };
layout(std430, binding = 3) buffer Densities      { float densities[];     };
layout(std430, binding = 4) buffer ViscForces     { vec4 viscForces[];     };
layout(std140, binding = 5) uniform Params {
  vec4 gravity;
  vec4 boundsSize;
  float deltaT;
  float smoothingRadius;
  float particleMass;
  float targetDensity;
  float pressureMultiplier;
  float viscosityStrength;
  float collisionDamping;
  float spikyPow2Scale;
  float spikyPow2GradScale;
  float poly6Scale;
  uint  numParticles;
  float epsilon;
  uint  paddedCount;
} P;
layout(std430, binding = 6) buffer SpatialKeys    { uint spatialKeys[];    };
layout(std430, binding = 7) buffer SpatialIndices { uint spatialIndices[]; };
layout(std430, binding = 8) buffer StartIndices   { uint startIndices[];   };

ivec3 cellCoord(vec3 p) { return ivec3(floor(p / P.smoothingRadius)); }
uint cellKey(ivec3 c) {
  uint a = uint(c.x) * 15823u;
  uint b = uint(c.y) * 9737333u;
  uint cc = uint(c.z) * 440817757u;
  return (a + b + cc) % P.numParticles;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= P.numParticles) return;

  vec3 pi = predicted[idx].xyz;
  vec3 vi = velocities[idx].xyz;
  float r2 = P.smoothingRadius * P.smoothingRadius;
  ivec3 center = cellCoord(pi);

  vec3 force = vec3(0.0);
  uint seen[27];
  int seenCount = 0;
  for (int dz = -1; dz <= 1; dz++)
  for (int dy = -1; dy <= 1; dy++)
  for (int dx = -1; dx <= 1; dx++) {
    uint key = cellKey(center + ivec3(dx, dy, dz));
    bool dup = false;
    for (int s = 0; s < seenCount; s++) if (seen[s] == key) { dup = true; break; }
    if (dup) continue;
    seen[seenCount++] = key;

    uint start = startIndices[key];
    if (start == 0xffffffffu) continue;
    for (uint e = start; e < P.numParticles && spatialKeys[e] == key; e++) {
      uint j = spatialIndices[e];
      if (j == idx) continue;
      float dst = length(predicted[j].xyz - pi);
      if (dst >= P.smoothingRadius) continue;
      float v = r2 - dst * dst;
      float influence = v * v * v * P.poly6Scale;
      force += (velocities[j].xyz - vi) * influence;
    }
  }
  viscForces[idx] = vec4(force * P.viscosityStrength, 0.0);
}
