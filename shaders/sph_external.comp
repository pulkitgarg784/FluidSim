#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 1) buffer Velocities { vec4 velocities[]; };
layout(std430, binding = 2) buffer Predicted { vec4 predicted[]; };
layout(std140, binding = 5) uniform Params {
  vec4 gravity;
  vec4 boundsSize;
  float deltaT;
  float smoothingRadius;
  float particleMass;
  float targetDensity;
  float pressureMultiplier;
  float viscosityStrength;
  float collisionDamping;
  float spikyPow2Scale;
  float spikyPow2GradScale;
  float poly6Scale;
  uint numParticles;
  float epsilon;
  uvec4 grid; // xyz = dimensions, w = total cells
} P;
layout(std430, binding = 6) buffer SpatialKeys { uint spatialKeys[]; };
layout(std430, binding = 7) buffer SpatialIndices { uint spatialIndices[]; };
layout(std140, binding = 12) uniform Interaction {
  vec4 point;
  float radius;
  float strength;
} I;

ivec3 gridCell(vec3 p) {
  ivec3 c = ivec3(floor((p + 0.5 * P.boundsSize.xyz) / P.smoothingRadius)) + ivec3(1);
  return clamp(c, ivec3(0), ivec3(P.grid.xyz) - ivec3(1));
}

uint cellKey(ivec3 c) {
  return (uint(c.z) * P.grid.y + uint(c.y)) * P.grid.x + uint(c.x);
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= P.numParticles) return;

  vec3 p = positions[i].xyz;
  vec3 v = velocities[i].xyz + P.gravity.xyz * P.deltaT;
  if (I.strength != 0.0) {
    vec3 offset = I.point.xyz - p;
    float dst2 = dot(offset, offset);
    float r2 = I.radius * I.radius;
    if (dst2 < r2) {
      float dst = sqrt(max(dst2, P.epsilon));
      float falloff = 1.0 - dst / I.radius;
      v += (offset / dst) * (I.strength * falloff) * P.deltaT;
    }
  }

  vec3 predictedPosition = p + v * P.deltaT;
  velocities[i] = vec4(v, 0.0);
  predicted[i] = vec4(predictedPosition, 0.0);
  spatialKeys[i] = cellKey(gridCell(predictedPosition));
  spatialIndices[i] = i;
}
